; ============================================================================
; ASUN - Array-Schema Unified Notation - text grammar, version 1.6
;
; This file is the SINGLE SOURCE OF TRUTH for the textual ASUN syntax.
; Every implementation MUST accept exactly the documents derivable from
; <asun-document> that also satisfy the semantic rules at the end of this file.
;
; Notation:
;   - RFC 5234 ABNF plus RFC 7405 case-sensitive strings (%s"...").
;     Every keyword and type name is case-sensitive: TRUE, Null, @INT are
;     not keywords or types.
;   - Core rules ALPHA, DIGIT, HEXDIG, DQUOTE, SP, HTAB, CR, LF, WSP come from
;     RFC 5234 Appendix B and are deliberately not redefined here.
;   - The file is pure ASCII so standard ABNF tools load it unmodified.
;   - Code points are Unicode scalar values; a document is UTF-8 encoded.
;
; Companions:
;   conformance/cases.json     - decode test vectors
;   conformance/runners/abnf/  - checks cases.json against this grammar
; ============================================================================

; ----------------------------------------------------------------------------
; Document
; ----------------------------------------------------------------------------

asun-document   = [ BOM ] ows top-form ows
BOM             = %xFEFF        ; decoders skip one leading BOM (see S10)

top-form        = object-form
                / array-of-objects-form
                / array
                / scalar        ; an empty document is NOT valid

; {schema}:(slot, slot, ...)
object-form     = schema ows ":" ows tuple

; [{schema}]:(row),(row),...    zero rows is an empty array
array-of-objects-form
                = "[" ows schema ows "]" ows ":" [ ows tuple-list ]
tuple-list      = tuple *( ows "," ows tuple )      ; no trailing comma

; ----------------------------------------------------------------------------
; Schema
; ----------------------------------------------------------------------------

schema          = "{" ows [ field *( ows "," ows field ) ows ] "}"
field           = field-name [ ows "@" ows binding ]
field-name      = bare-name / quoted-string
bare-name       = 1*( ALPHA / DIGIT / "_" )

binding         = scalar-type
                / schema                            ; addr@{city,zip}
                / array-type                        ; tags@[str], users@[{id}]
                / map-type                          ; attrs@[str:int]
scalar-type     = %s"int" / %s"float" / %s"str" / %s"bool"
array-type      = "[" ows [ binding ows ] "]"       ; tags@[] = untyped array
map-type        = "[" ows [ key-type ows ] ":" ows [ binding ows ] "]"
                ; attrs@[:] = untyped map; key and value types are optional
key-type        = %s"str" / %s"int"

; ----------------------------------------------------------------------------
; Data
;
; Every position holds exactly one element; there are no empty slots.
; Null is written "_". A comma only separates two elements, so a leading,
; trailing or doubled comma is an error.
;   ()      zero elements (matches the zero-field schema "{}")
;   (_)     one element, null           []      empty array or empty map
;   (a,_)   a, null                     [_]     one null element
;   (a,)  (,)  [1,,3]  [,]              all errors
; ----------------------------------------------------------------------------

tuple           = "(" ows [ element *( ows "," ows element ) ows ] ")"

array           = "[" ows [ element *( ows "," ows element ) ows ] "]"

; A map is only valid where the binding is a <map-type> (see S11). The empty
; map is written "[]", which is the <array> production.
map             = "[" ows entry *( ows "," ows entry ) ows "]"
entry           = map-key ows ":" ows element
map-key         = keyword / number / quoted-string / key-string

element         = scalar / tuple / array / map

; ----------------------------------------------------------------------------
; Scalars
; ----------------------------------------------------------------------------

scalar          = keyword / number / quoted-string / plain-string
keyword         = %s"true" / %s"false" / "_"      ; "_" is null

; -- Numbers -----------------------------------------------------------------
; Exactly the JSON number grammar (RFC 8259 section 6). A leading "-" must
; touch the first digit and the integer part has no leading zeros. ".5",
; "5.", "+5", "1e", "1e+", "- 5", "007", "01.5" are not numbers; unquoted
; they are plain strings (see S2).

number          = [ "-" ] int [ fraction ] [ exponent ]
int             = "0" / %x31-39 *DIGIT
fraction        = "." 1*DIGIT
exponent        = ( %s"e" / %s"E" ) [ "+" / "-" ] 1*DIGIT

; -- Quoted strings ----------------------------------------------------------
; Exactly the JSON string grammar (RFC 8259 section 7).
; Raw control characters U+0000-U+001F must be escaped; DEL, C1 controls,
; U+2028 and U+2029 may appear raw.

quoted-string   = DQUOTE *( qchar / escape ) DQUOTE
qchar           = %x20-21 / %x23-5B / %x5D-D7FF / %xE000-10FFFF

escape          = "\" ( DQUOTE / "\" / "/"
                      / %s"b" / %s"f" / %s"n" / %s"r" / %s"t"
                      / %s"u" 4HEXDIG )             ; see S5 for surrogates

; -- Plain (unquoted) strings ------------------------------------------------
; Words separated by runs of SP/HTAB. Leading and trailing whitespace is not
; part of the string: it is matched by the surrounding <ows>, which is how
; trimming falls out of the grammar. A plain string has no escapes: it is
; exactly the source text.
;
; Raw characters that are NOT allowed in a plain string:
;     , ( ) [ ] { } " \     control characters U+0000-U+001F
;     the two-character sequence "/*"  (it always opens a comment)
; A string that needs any of them must be quoted. Everything else is allowed
; raw, in particular ":" "@" "/" "*" "#" "'":
;     alice@example.com   12:30   https://a.com/x   2024-01-01T10:00:00Z
;
; <word> is the regular language (P|T)* (S+ P (P|T)*)* S* without the empty
; string, where S = "/", T = "*", P = <pchar>; i.e. no "/" is ever directly
; followed by "*".

plain-string    = word *( 1*WSP word )
word            = 1*pstar *( 1*"/" pchar *pstar ) *"/"
                / 1*( 1*"/" pchar *pstar ) *"/"
                / 1*"/"
pstar           = pchar / "*"
pchar           = kchar / ":"

; A map key written as a plain string additionally excludes ":" (the first
; ":" ends the key). A key containing ":" must be quoted.

key-string      = kword *( 1*WSP kword )
kword           = 1*kstar *( 1*"/" kchar *kstar ) *"/"
                / 1*( 1*"/" kchar *kstar ) *"/"
                / 1*"/"
kstar           = kchar / "*"
kchar           = %x21 / %x23-27 / %x2B / %x2D-2E / %x30-39 / %x3B-5A
                / %x5E-7A / %x7C / %x7E-D7FF / %xE000-10FFFF
                ; every scalar value except controls, SP, and
                ; " ( ) * , / : [ \ ] { }

; ----------------------------------------------------------------------------
; Layout: whitespace and comments
;
; Comments are layout, exactly like whitespace: allowed between any two
; tokens (schema, tuples, arrays, around ":" and ","), never inside a
; quoted string, plain string, number or keyword.
; ----------------------------------------------------------------------------

ows             = *( WSP / CR / LF / comment )
comment         = "/*" *( cnostar / 1*"*" cnoend ) 1*"*" "/"
cnostar         = %x00-29 / %x2B-D7FF / %xE000-10FFFF      ; not "*"
cnoend          = %x00-29 / %x2B-2E / %x30-D7FF / %xE000-10FFFF
                ; not "*" and not "/"

; ============================================================================
; Semantic rules (enforced by conformance tests, not expressible in ABNF)
; ============================================================================
;
; S1. Element alignment.
;     A tuple MUST have exactly as many elements as its schema has fields.
;     Fewer or more is an error - decoders MUST NOT pad, truncate or
;     silently skip. A missing value is written "_", never left blank.
;
; S2. Unquoted token resolution (no scalar hint).
;       exactly "_"                     -> null
;       exactly "true" / "false"        -> boolean
;       matches <number> without fraction/exponent -> integer
;       matches <number> with fraction or exponent -> float
;       anything else                   -> string
;     A quoted string is always a string: "_", "true", "42" are strings.
;     There is no "null" keyword: unquoted null is the string "null". A typed decoder reading an unquoted non-null token into a
;     string target takes the token text, as if the field were @str
;     (90210 -> "90210"); "_" stays null.
;
; S3. Scalar hints are authoritative.
;       @int    value MUST be an integer literal (or null)
;       @float  value MUST be an integer or float literal (or null)
;       @bool   value MUST be true / false (or null)
;       @str    every non-null value is a string: unquoted 42 or true is the
;               string "42" / "true"; "_" stays null
;     A value that does not satisfy its hint is an error (007 under @int is
;     the string "007", so it is an error). A typed decoder MUST also reject
;     a hint that is incompatible with the target type (e.g. @str into an
;     integer field).
;
; S4. Numeric range.
;     The grammar does not bound numbers. A decoder MUST report an error when
;     a value does not fit the target type: integer overflow, a fractional or
;     exponent literal into an integer target, or a float literal whose
;     magnitude overflows to infinity. Decoders MUST NOT truncate, wrap or
;     round to infinity. Non-finite floats (NaN, Infinity) have no textual
;     form; encoders MUST reject them.
;
; S5. Escapes.
;     Escapes exist only inside quoted strings and follow JSON. \uXXXX
;     denotes a UTF-16 code unit. A high surrogate (D800-DBFF) MUST be
;     immediately followed by \u + low surrogate (DC00-DFFF) and the pair
;     denotes one scalar value. A lone surrogate is an error. Any escape not
;     listed in <escape> (including \, \( \: \@) is an error, and a "\"
;     outside a quoted string is an error.
;
; S6. Field names.
;     A quoted field name is compared after unescaping: {"a"} and {a}
;     name the same field. No Unicode normalization is applied. Two fields
;     with the same (unescaped) name in one schema is an error.
;
; S7. Null.
;     "_" is the only way to write null. A string whose content is "_",
;     "true" or "false", or that matches <number>, MUST be quoted by
;     encoders.
;
; S8. Bindings.
;     A field whose values contain tuples (nested objects) or maps needs a
;     structural binding (@{...}, @[{...}] or @[K:V]) so untyped decoders
;     know the shape. Encoders MUST emit it. Typed decoders MAY accept its
;     absence.
;
; S9. Rows.
;     "[{schema}]:" followed by no tuple is an empty array. Rows are never
;     null and the row list has no trailing comma.
;
; S10. BOM and line endings.
;     A decoder MUST skip a single leading U+FEFF. Encoders MUST NOT emit it.
;     CR, LF and CRLF are all layout.
;
; S11. Maps.
;     A value is a <map> exactly when its binding is a <map-type> (or, per
;     S8, a typed decoder's target is a map). Everywhere else "[" opens an
;     <array> and ":" is ordinary plain-string content, so [a:1] without a
;     map binding is the array ["a:1"]. A map is never a top-level form.
;       - "[]" is the empty map.
;       - Keys are resolved by the key-type (str: token text as for @str;
;         int: an integer literal) or, when the key-type is omitted, by S2.
;         A key MUST resolve to a string or an integer: "_", true, false
;         and float keys are errors.
;       - A plain key never contains ":"; the first ":" after the key
;         separates key and value. The value may contain ":" freely:
;         [start:12:30] is start -> "12:30".
;       - Two entries with the same key (after resolution) are an error.
;       - Entry order is preserved by the text; it carries no meaning.
;       - Values follow the value binding like any other element; "_" is a
;         null value.
